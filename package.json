{
  "name": "shell-sheet-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/lovecraft-start"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "typecheck:demo": "tsc -p examples/lovecraft-start/tsconfig.json --pretty false",
    "typecheck:contracts": "tsc -p packages/react/type-test/tsconfig.json --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:vanilla": "vite examples/vanilla",
    "dev:lovecraft": "vite --config examples/lovecraft-start/vite.config.ts",
    "build:lovecraft": "vite build --config examples/lovecraft-start/vite.config.ts",
    "clean": "tsc -b --clean"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "effector": "^23.4.4",
    "effector-react": "^23.3.0",
    "jsdom": "^29.1.1",
    "motion": "^12.43.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
