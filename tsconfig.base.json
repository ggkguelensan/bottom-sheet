{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@shell-sheet/core": ["./packages/core/src/index.ts"],
      "@shell-sheet/dom": ["./packages/dom/src/index.ts"],
      "@shell-sheet/motion": ["./packages/motion/src/index.ts"],
      "@shell-sheet/effector": ["./packages/effector/src/index.ts"],
      "@shell-sheet/react": ["./packages/react/src/index.ts"]
    }
  }
}
