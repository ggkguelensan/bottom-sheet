{
  "name": "shell-sheet-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/lovecraft-start"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.tooling.json --pretty false",
    "typecheck:demo": "tsc -p examples/lovecraft-start/tsconfig.json --pretty false",
    "typecheck:contracts": "tsc -p packages/react/type-test/tsconfig.json --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:vanilla": "vite examples/vanilla",
    "dev:lovecraft": "vite --config examples/lovecraft-start/vite.config.ts",
    "build:lovecraft": "vite build --config examples/lovecraft-start/vite.config.ts",
    "test:ssr": "npm run build:lovecraft && vitest run packages/react/test/ssr.test.tsx examples/lovecraft-start/src/ssr.test.ts && tsx scripts/test-ssr.ts",
    "test:browser": "playwright test",
    "check:architecture": "tsx scripts/check-architecture.ts",
    "check:bundles": "tsx scripts/check-bundles.ts",
    "check:packages": "npm run build && tsx scripts/check-packages.ts",
    "check:all": "npm run typecheck && npm test && npm run build && npm run build:lovecraft && npm run test:ssr && npm run test:browser && npm run check:packages && npm run check:architecture && npm run check:bundles",
    "clean": "tsc -b --clean"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.0.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "axe-core": "^4.10.3",
    "effector": "^23.4.4",
    "effector-react": "^23.3.0",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "motion": "^12.0.0",
    "publint": "^0.3.13",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
